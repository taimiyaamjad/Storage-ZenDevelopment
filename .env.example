PORT=5000
JWT_SECRET=change-this-to-a-secure-random-string
SESSION_SECRET=change-this-to-a-secure-random-string
DB_FILE=data.sqlite

# Default VPS Storage Root Directory
STORAGE_ROOT=/var/vps_storage

# Optional default SFTP settings for remote VPS connection
SFTP_HOST=127.0.0.1
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=

# Application Settings
APP_NAME=ZenStorage
APP_URL=http://storage.zendevelopment.in
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
MAX_SHARE_LINKS_PER_USER=3
ANTI_MULTI_ACCOUNT_ENABLED=true

# Browser-compatible video preview cache and FFmpeg limits
PREVIEW_CACHE_ROOT=/tmp/vps-sftp-preview-cache
PREVIEW_MAX_TRANSCODES=2
PREVIEW_FFMPEG_PRESET=veryfast
PREVIEW_FFMPEG_CRF=23

# Fast fallback preview for videos whose original codec the browser cannot decode
PREVIEW_FFMPEG_LIVE_PRESET=ultrafast
PREVIEW_FFMPEG_LIVE_CRF=27
